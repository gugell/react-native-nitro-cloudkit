{
  "expo": {
    "name": "CloudKit Example",
    "slug": "nitro-cloudkit-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.gugell.nitrocloudkit.example",
      "supportsTablet": true
    },
    "android": { "package": "com.gugell.nitrocloudkit.example" },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": [
      [
        "react-native-nitro-cloudkit",
        { "containerIdentifier": "iCloud.com.gugell.nitrocloudkit.example" }
      ]
    ]
  }
}
