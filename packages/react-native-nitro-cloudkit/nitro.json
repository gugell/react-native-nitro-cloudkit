{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["cloudkit"],
  "ios": {
    "iosModuleName": "NitroCloudKit"
  },
  "android": {
    "androidNamespace": ["cloudkit"],
    "androidCxxLibName": "NitroCloudKit"
  },
  "autolinking": {
    "CloudKit": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridCloudKit"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridCloudKit"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
